// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Status {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Tier {
  Tier1
}

enum AccountType {
  USER
  SYSTEM_BANK
}

enum Currency {
  NGN
}

enum Provider {
  FLUTTERWAVE
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  firstName      String?
  lastName       String?
  displayName    String
  password       String
  role           Role          @default(USER)
  transactionPin String?
  tier           Tier          @default(Tier1)
  phone          String?       @unique
  bvnMasked      String?
  ninMasked      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  accounts       Account[]
  transactions   Transaction[]
  payments       Payment[]

  @@index([email, displayName])
  @@map("users")
}

model Account {
  id           String      @id @default(cuid())
  userId       String? // NULL for system account
  name         String // e.g., "Main Wallet", "System_Escrow"
  account_type AccountType @default(USER)
  balance      Decimal     @default(0.00)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  ledgersOut LedgerEntry[] @relation("SourceLedger")
  ledgersIn  LedgerEntry[] @relation("DestLedger")

  @@index([userId, balance])
  @@map("accounts")
}

model Transaction {
  id                String  @id @default(cuid())
  userId            String
  amount            Decimal // The total amount charged to the user
  type              String // e.g., "AIRTIME"
  status            String  @default("PENDING") // PENDING, SUCCESS, FAILED
  providerReference String? // The ID from VTpass/Reloadly

  // A transaction connects to the ledger entries it caused!
  user          User?         @relation(fields: [userId], references: [id])
  ledgerEntries LedgerEntry[]

  createdAt DateTime  @default(now())
  payments  Payment[]
}

model LedgerEntry {
  id          String  @id @default(cuid())
  amount      Decimal
  description String // e.g., "Airtime purchase cost", "System profit"

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  // FIXED: Explicitly link these IDs to the Account model
  sourceAccountId String
  sourceAccount   Account @relation("SourceLedger", fields: [sourceAccountId], references: [id])

  destAccountId String
  destAccount   Account @relation("DestLedger", fields: [destAccountId], references: [id])

  createdAt DateTime @default(now())
}

model Payment {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  amount   Decimal
  currency Currency @default(NGN)

  provider    Provider @default(FLUTTERWAVE)
  providerRef String?
  reference   String   @unique // YOUR internal reference

  status PaymentStatus @default(PENDING)

  description String?

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([provider, providerRef])
}

model WebhookLog {
  id String @id @default(uuid())

  provider   String
  externalId String

  payload Json?

  status WebhookStatus @default(PENDING)
  error  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider, externalId])
}
